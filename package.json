{
  "name": "dokaai-make",
  "version": "0.1.0",
  "description": "DokaAI Make custom app generated from the DokaAI OpenAPI contract.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "npm run build && node dist/src/scripts/build-app.js",
    "validate": "npm run build && node dist/src/scripts/validate-config.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "check": "npm run validate && npm run test && npm run generate",
    "push-make": "npm run generate && node dist/src/scripts/push-make.js"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
