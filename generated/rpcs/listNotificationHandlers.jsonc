{
  "name": "listNotificationHandlers",
  "label": "List Notification Handlers",
  "communication": {
    "url": "/nudge/projects/{{parameters.projectId}}/notification-handlers/",
    "method": "GET",
    "response": {
      "iterate": "{{ifempty(body.data, body.items, body.results, body)}}",
      "output": {
        "label": "{{ifempty(item.name, item.projectName, item.customerPoolName, item.title, item.label, item.key, item.id)}}",
        "value": "{{ifempty(item.id, item.projectId, item.customerPoolId, item.targetAudienceListId, item.notificationHandlerId, item.fieldName, item.key)}}"
      }
    }
  }
}
