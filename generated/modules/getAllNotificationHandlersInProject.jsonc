{
  "name": "getAllNotificationHandlersInProject",
  "label": "List Notification Handlers",
  "description": "Get all notification handlers in the current project.",
  "type": "search",
  "connection": "dokaai-api",
  "expect": [
    {
      "name": "projectId",
      "type": "select",
      "label": "Project Id",
      "required": true,
      "options": {
        "store": "rpc://listProjects"
      }
    },
    {
      "name": "search",
      "type": "text",
      "label": "Search",
      "required": false
    },
    {
      "name": "page",
      "type": "text",
      "label": "Page",
      "required": true,
      "default": "1"
    },
    {
      "name": "size",
      "type": "text",
      "label": "Size",
      "required": true,
      "default": "25"
    }
  ],
  "interface": [],
  "communication": {
    "url": "/nudge/projects/{{parameters.projectId}}/notification-handlers/",
    "method": "GET",
    "response": {
      "iterate": "{{body.data}}",
      "output": "{{item}}"
    },
    "qs": {
      "search": "{{parameters.search}}",
      "page": "{{parameters.page}}",
      "size": "{{parameters.size}}"
    }
  }
}
