{
  "name": "addCustomersToPool",
  "label": "Add Customers to Pool",
  "description": "Add customers to a customer pool.",
  "type": "action",
  "connection": "dokaai-api",
  "expect": [
    {
      "name": "projectId",
      "type": "select",
      "label": "Project Id",
      "required": true,
      "options": {
        "store": "rpc://listProjects",
        "nested": [
          {
            "name": "customerPoolId",
            "type": "select",
            "label": "Customer Pool Id",
            "required": true,
            "options": {
              "store": "rpc://listCustomerPools",
              "nested": [
                "rpc://listCustomerPoolAttributes"
              ]
            }
          },
          {
            "name": "targetAudienceListId",
            "type": "select",
            "label": "Target Audience List Id",
            "required": false,
            "options": {
              "store": "rpc://listTargetAudienceLists"
            }
          }
        ]
      }
    },
    {
      "name": "customerData",
      "type": "collection",
      "label": "Customer Data",
      "required": true,
      "spec": [
        {
          "name": "uniqueCustomerId",
          "type": "text",
          "label": "Unique Customer Id",
          "required": true
        },
        {
          "name": "emailId",
          "type": "text",
          "label": "Email Id",
          "required": false
        },
        {
          "name": "phoneNumber",
          "type": "text",
          "label": "Phone Number",
          "required": false
        },
        {
          "name": "pushContactPoints",
          "type": "array",
          "label": "Push Contact Points",
          "required": false,
          "spec": [
            {
              "name": "provider",
              "type": "select",
              "label": "Provider",
              "required": true,
              "options": [
                {
                  "label": "Firebase Cloud Messaging",
                  "value": "firebaseCloudMessaging"
                },
                {
                  "label": "Apns",
                  "value": "apns"
                },
                {
                  "label": "Expo",
                  "value": "expo"
                }
              ]
            },
            {
              "name": "token",
              "type": "text",
              "label": "Token",
              "required": true
            },
            {
              "name": "platform",
              "type": "select",
              "label": "Platform",
              "required": false,
              "options": [
                {
                  "label": "Ios",
                  "value": "ios"
                },
                {
                  "label": "Android",
                  "value": "android"
                }
              ]
            }
          ]
        },
        {
          "name": "name",
          "type": "text",
          "label": "Name",
          "required": false
        },
        {
          "name": "pinCode",
          "type": "text",
          "label": "Pin Code",
          "required": false
        },
        {
          "name": "countryIsoCode",
          "type": "text",
          "label": "Country Iso Code",
          "required": false
        },
        {
          "name": "timeZone",
          "type": "text",
          "label": "Time Zone",
          "required": false
        }
      ]
    }
  ],
  "interface": [],
  "communication": {
    "url": "/customer/projects/{{parameters.projectId}}/customer-pools/{{parameters.customerPoolId}}/customers",
    "method": "POST",
    "response": {
      "output": "{{body}}"
    },
    "body": "{{omit(parameters, 'customerPoolId', 'projectId')}}",
    "type": "json"
  }
}
