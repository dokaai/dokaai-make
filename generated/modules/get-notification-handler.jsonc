{
  "name": "get-notification-handler",
  "label": "Get Notification Handler",
  "description": "Get a notification handler by id.",
  "type": "search",
  "connection": "dokaai-api",
  "expect": [
    {
      "name": "projectId",
      "type": "select",
      "label": "Project Id",
      "required": true,
      "options": "rpc://list-projects"
    },
    {
      "name": "notificationHandlerId",
      "type": "select",
      "label": "Notification Handler Id",
      "required": true,
      "options": "rpc://list-notification-handlers"
    }
  ],
  "interface": [],
  "communication": {
    "url": "/nudge/projects/{{parameters.projectId}}/notification-handlers/{{parameters.notificationHandlerId}}",
    "method": "GET",
    "response": {
      "iterate": "{{ifempty(body.data, body.items, body.results, body)}}",
      "output": "{{item}}"
    }
  }
}
